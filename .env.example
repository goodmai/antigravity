# Example env — copy to .env (gitignored) and fill in. Never commit real secrets.

# ── Pinata (IPFS pinning for Lit Actions) — see skills/pinata/SKILL.md ──
# Preferred: a Bearer JWT from the Pinata app (works with the v3 upload API).
PINATA_JWT=
# Legacy api key + secret (both required together for uploads if no JWT).
PINATA_API_KEY=
PINATA_API_SECRET=
# Your dedicated Pinata gateway host (no protocol), e.g. fun-llama-300.mypinata.cloud
PINATA_GATEWAY=
