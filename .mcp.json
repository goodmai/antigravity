{
  "mcpServers": {
    "chrome-devtools": {
      "command": "/home/g/.local/share/fnm/aliases/default/bin/npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "env": {
        "PATH": "/home/g/.local/share/fnm/aliases/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      }
    },
    "lit-discord": {
      "command": "node",
      "args": ["tools/discord-lit-mcp/server.mjs"],
      "env": {
        "DISCORD_USER_TOKEN": "${DISCORD_USER_TOKEN}",
        "LIT_DISCORD_GUILD_ID": "${LIT_DISCORD_GUILD_ID:-896185694857343026}",
        "LIT_DISCORD_CHANNEL_ID": "${LIT_DISCORD_CHANNEL_ID:-1100139039241277470}"
      }
    }
  }
}
